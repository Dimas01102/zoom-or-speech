rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Riwayat scan milik user
    match /history/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Pengaturan milik user
    match /user_setting/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Konten tutorial hanya bisa dibaca user yang login
    match /content/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Log penggunaan tidak boleh diakses dari client
    match /usage_logs/{document=**} {
      allow read, write: if false;
    }

    // Kredensial service tidak boleh diakses dari client
    match /service_credentials/{document=**} {
      allow read, write: if false;
    }

    // Data admin tidak boleh diakses dari client
    match /admin/{document=**} {
      allow read, write: if false;
    }

    // Semua collection lain ditolak secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}